# ExpertBay AI Quality & Privacy Evaluation Pilot Configuration

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (Defaults to SQLite for instant local execution, or PostgreSQL for production)
DATABASE_URL=sqlite:///./expertbay_eval.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expertbay_evaluation

# Pilot Benchmark Baseline Parameters
STARTING_ENG_QUESTIONS=180
STARTING_RETRIEVAL_PROBES=84
PILOT_CODE=EXBAY-PILOT-2026

# Privacy & Security Guardrails
DPDP_PII_MASKING_ENABLED=true
DOUBLE_BLIND_EVALUATION=true
CRITICAL_STOP_GATE_ENFORCED=true
AUDIT_LOG_RETENTION_DAYS=90

# JWT Authentication (HS256)
# IMPORTANT: Change JWT_SECRET_KEY to a strong random secret in production (min 32 chars).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=demo-secret-change-in-production-min32chars!
JWT_EXPIRE_MINUTES=480

# Demo Accounts (any non-empty password is accepted in demo mode)
# admin@demo-expertbay.org          → admin (full access)
# coordinator@demo-expertbay.org    → pilot_coordinator (nominate, assign, verify)
# techreviewer@demo-expertbay.org   → technical_reviewer (evaluate only)
# domainreviewer@demo-expertbay.org → domain_reviewer (evaluate only)
# adjudicator@demo-expertbay.org    → adjudicator (evaluate + resolve disagreements)
# stakeholder@demo-expertbay.org    → stakeholder (read-only reports)
